generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model FarmPlot {
  id         String   @id @default(cuid())
  user       String   @unique
  size       Int      @default(8)
  tiles      String   @default("[]")
  expandedAt DateTime @default(now())
}

model FarmBuilding {
  id       String @id @default(cuid())
  user     String
  tileX    Int
  tileY    Int
  toolMint String
  type     String

  @@unique([user, tileX, tileY])
}

model Energy {
  id         String   @id @default(cuid())
  user       String   @unique
  amount     Int      @default(20)
  cap        Int      @default(20)
  lastUpdate DateTime @default(now())
}

model NeighborVisit {
  id      String   @id @default(cuid())
  visitor String
  host    String
  action  String
  ts      DateTime @default(now())
}

model Weather {
  id   String @id @default(cuid())
  date String @unique
  type String
}

model InboxItem {
  id           String    @id @default(cuid())
  user         String
  sender       String
  subject      String
  body         String
  rewardType   String?
  rewardAmount Int?
  expiresAt    DateTime?
  claimed      Boolean   @default(false)
  claimState   String    @default("unclaimed")
  claimSignature String?
  rewardVersion Int @default(1)
  claimMint String?
  @@index([claimState, id])
  read         Boolean   @default(false)
  createdAt    DateTime  @default(now())
}

model CompendiumEntry {
  id       String   @id @default(cuid())
  user     String
  toolType String
  rarity   String
  seenAt   DateTime @default(now())

  @@unique([user, toolType, rarity])
}

model Profile {
  id       String  @id @default(cuid())
  user     String  @unique
  nickname String?
  avatar   String?
  title    String?
  showcase String  @default("[]")
}

model Streak {
  id        String    @id @default(cuid())
  user      String    @unique
  current   Int       @default(0)
  longest   Int       @default(0)
  lastLogin DateTime?
}

model OnboardingState {
  id        String  @id @default(cuid())
  user      String  @unique
  step      Int     @default(0)
  completed Boolean @default(false)
}

model LoreProgress {
  id        String  @id @default(cuid())
  user      String
  arcId     String
  nodeId    String
  completed Boolean @default(false)

  @@unique([user, arcId, nodeId])
}

model QuestProgressDb {
  id        String   @id @default(cuid())
  user      String
  questId   Int
  progress  Int      @default(0)
  completed Boolean  @default(false)
  updatedAt DateTime @default(now())

  @@unique([user, questId])
}

model ChallengeScore {
  id         String @id @default(cuid())
  user       String
  weekNumber Int
  medals     Int    @default(0)

  @@unique([user, weekNumber])
}

model TrustBreakdown {
  id         String   @id @default(cuid())
  user       String   @unique
  score      Int      @default(0)
  tier       Int      @default(1)
  components String   @default("{}")
  computedAt DateTime @default(now())
}

model Guild {
  id         String          @id @default(cuid())
  name       String          @unique
  leaderId   String
  createdAt  DateTime        @default(now())
  activities GuildActivity[]
  members    GuildMember[]
}

model GuildMember {
  id       String   @id @default(cuid())
  guildId  String
  user     String
  role     String   @default("member")
  joinedAt DateTime @default(now())
  guild    Guild    @relation(fields: [guildId], references: [id])

  @@unique([guildId, user])
}

model GuildActivity {
  id      String   @id @default(cuid())
  guildId String
  actor   String
  action  String
  amount  Int?
  ts      DateTime @default(now())
  guild   Guild    @relation(fields: [guildId], references: [id])
}

model PriceAlert {
  id        String   @id @default(cuid())
  user      String
  rarity    String?
  currency  String?
  direction String?
  threshold Float
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ReferralStatsDb {
  id          String   @id @default(cuid())
  user        String   @unique
  directCount Int      @default(0)
  l2Count     Int      @default(0)
  updatedAt   DateTime @default(now())
}

model WhaleAlert {
  id     String   @id @default(cuid())
  type   String
  mint   String?
  amount Float
  price  Float?
  ts     DateTime @default(now())
}

model PriceTick {
  id          String   @id @default(cuid())
  rarity      Int
  priceMascot Float
  priceSol    Float
  side        String?
  mint        String?
  ts          DateTime @default(now())

  @@index([rarity, ts])
}

model Candle {
  id        String   @id @default(cuid())
  rarity    Int
  timeframe String
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float    @default(0)
  tsStart   DateTime

  @@unique([rarity, timeframe, tsStart])
  @@index([rarity, timeframe, tsStart])
}

model TraderRule {
  id             String   @id @default(cuid())
  user           String
  type           String
  rarity         Int?
  toolType       String?
  currency       String?
  threshold      Float?
  direction      String?
  maxSpendPerDay Float?
  active         Boolean  @default(true)
  paused         Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([user, type])
}

model TraderExecution {
  id        String   @id @default(cuid())
  user      String
  ruleId    String
  action    String
  mint      String?
  price     Float?
  signature String?
  success   Boolean  @default(false)
  error     String?
  ts        DateTime @default(now())

  @@index([user, ts])
}

model TrustScore {
  id              String   @id @default(cuid())
  user            String   @unique
  score           Int      @default(0)
  tier            Int      @default(1)
  ageScore        Int      @default(0)
  referralScore   Int      @default(0)
  traderScore     Int      @default(75)
  stakingScore    Int      @default(0)
  rebirthScore    Int      @default(0)
  guildScore      Int      @default(0)
  compendiumScore Int      @default(0)
  questScore      Int      @default(0)
  craftRepScore   Int      @default(0)
  antiBotScore    Int      @default(50)
  penaltyMult     Float    @default(1.0)
  computedAt      DateTime @default(now())
}

model TrustFlag {
  id        String    @id @default(cuid())
  user      String
  flagType  String
  mult      Float
  issuedAt  DateTime  @default(now())
  expiresAt DateTime?
  active    Boolean   @default(true)

  @@index([user, active])
}

model ComebackRecord {
  id            String   @id @default(cuid())
  user          String   @unique
  lastSeen      DateTime @default(now())
  totalAbsences Int      @default(0)
}

model ComebackBonus {
  id          String   @id @default(cuid())
  user        String
  absenceDays Int
  bonusType   String
  claimed     Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([user, absenceDays])
}

model Territory {
  id          String    @id @default(cuid())
  territoryId String    @unique
  name        String
  guildId     String?
  bonusType   String?
  contestedAt DateTime?

  @@index([guildId])
}

model LeaderboardSnapshot {
  id           String   @id @default(cuid())
  period       String
  periodId     Int
  merkleRoot   String
  totalEntries Int
  createdAt    DateTime @default(now())

  @@unique([period, periodId])
}

model LeaderboardEntry {
  id         String @id @default(cuid())
  snapshotId String
  user       String
  rank       Int
  score      Float
  proof      String

  @@unique([snapshotId, user])
  @@index([snapshotId, rank])
}

model DeviceFingerprint {
  id          String   @id @default(cuid())
  user        String
  fingerprint String
  firstSeen   DateTime @default(now())
  lastSeen    DateTime @default(now())

  @@unique([user, fingerprint])
  @@index([fingerprint])
}

model SybilFlag {
  id        String    @id @default(cuid())
  user      String
  reason    String
  severity  Int       @default(1)
  issuedAt  DateTime  @default(now())
  expiresAt DateTime?
  active    Boolean   @default(true)

  @@index([user, active])
}

model ReferralHolding {
  id          String   @id @default(cuid())
  referrer    String
  referred    String
  rewardType  String
  amount      Float
  availableAt DateTime
  claimed     Boolean  @default(false)

  @@unique([referrer, referred, rewardType])
}

model ApiKey {
  id         String    @id @default(cuid())
  key        String    @unique
  label      String
  tier       String    @default("free")
  rateLimit  Int       @default(60)
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}

model DeviceToken {
  id        String   @id @default(cuid())
  user      String
  platform  String
  token     String   @unique
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([user, enabled])
}

model NotificationQueue {
  id        String   @id @default(cuid())
  user      String
  type      String
  title     String
  body      String
  payload   String?
  sent      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([user, sent])
}

model IdempotencyRecord {
  id           String    @id @default(cuid())
  operationKey String    @unique
  status       String
  result       String?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  @@index([operationKey])
  @@index([status, createdAt])
}

model AllowedMint {
  id      String   @id @default(cuid())
  mint    String   @unique
  label   String
  active  Boolean  @default(true)
  addedAt DateTime @default(now())
}

model WalletOperation {
  id             String   @id @default(cuid())
  wallet         String
  operationType  String
  volumeLamports Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([wallet, createdAt])
}

model AuditRecord {
  id        String   @id @default(cuid())
  action    String
  wallet    String
  amount    Float    @default(0)
  mint      String
  signature String
  status    String
  details   String
  ipAddress String
  userAgent String
  createdAt DateTime @default(now())

  @@index([wallet, createdAt])
  @@index([status, createdAt])
  @@index([action, createdAt])
}

model CircuitBreaker {
  id        String   @id @default(cuid())
  state     String
  reason    String
  updatedAt DateTime @default(now())
}

model PlayerProfile {
  id        String   @id @default(cuid())
  address   String   @unique
  username  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([username])
}

model FriendWatering {
  id        String   @id @default(cuid())
  owner     String
  waterer   String
  wateredAt DateTime @default(now())
  bonusPct  Int      @default(1)

  @@unique([owner, waterer, wateredAt])
  @@index([owner])
  @@index([waterer])
}

// [SENTINEL] Audit log для всех действий игроков
model AuditLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  
  // Кто выполнил действие
  user      String   // wallet address
  action    String   // "craft", "place_order", "rebirth", etc.
  
  // Что было сделано
  metadata  String?  // JSON-строка (SQLite не поддерживает Json)
  result    String?  // "success" | "fail"
  
  // On-chain данные (если есть)
  txSig     String?  // transaction signature
  programId String?  // program ID
  
  // Для расследования споров
  ip        String?
  userAgent String?
  
  @@index([user, timestamp])
  @@index([action, timestamp])
  @@index([txSig])
}

// [OPENCLAW] Snapshot экономики для мониторинга
model EconomySnapshot {
  id             String   @id @default(cuid())
  timestamp      DateTime @default(now())
  
  // POTATO метрики
  potatoSupply   BigInt   // Total supply
  potatoBurned24h BigInt  // Burned за 24 часа
  potatoMinted24h BigInt  // Minted за 24 часа
  inflation24h   Float    // Процент инфляции
  
  // Активность
  activeCrafters24h Int
  activeTraders24h  Int
  totalTxs24h       Int
  failedTxs24h      Int
  
  // Топ кошельки (JSON)
  topHolders     String   // JSON array [{address, balance}]
  
  @@index([timestamp])
}

// [OPENCLAW] Алерты экономики
model EconomyAlert {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  
  type      String   // "inflation", "whale", "tx_spike", "circuit_breaker"
  severity  String   // "info", "warning", "critical"
  message   String
  metadata  String   // JSON с деталями
  
  resolved  Boolean  @default(false)
  resolvedAt DateTime?
  
  @@index([timestamp])
  @@index([resolved, timestamp])
}

// [CYNIC] Рейтинги между игроками
model PlayerRating {
  id           String   @id @default(cuid())
  timestamp    DateTime @default(now())
  
  // Кто кого оценил
  fromUser     String   // оценщик
  toUser       String   // оцениваемый
  
  // Контекст оценки
  context      String   // "trade", "craft", "guild"
  referenceId  String?  // order ID / craft ID / etc
  
  // Оценка
  rating       Int      // 1-5 звёзд
  comment      String?  // опциональный комментарий
  
  // Proof-of-Stake weighting (чем больше stake — тем весомее голос)
  stakeWeight  Float    @default(1.0)
  
  @@index([toUser, timestamp])
  @@index([fromUser, toUser])
  @@unique([fromUser, toUser, context, referenceId])
}

model CommitSecret {
  id        String   @id @default(cuid())
  key       String   @unique
  secret    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  used      Boolean  @default(false)
  
  @@index([key])
  @@index([expiresAt])
}

// Persist pagination even when the one-shot reconciler exits or is restarted.
model ReconciliationCursor {
  name      String   @id
  lastId    String?
  updatedAt DateTime @updatedAt
}
