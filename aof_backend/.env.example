# Variable inventory only: intentionally empty. Set explicit deployment values.
# Do not copy this file unchanged into a running environment.
# aof_backend environment template.
# Copy to .env and fill in the values. NEVER commit .env (.gitignore covers it).
# Required settings must be supplied through your deployment secret manager.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# development | production. In production the backend refuses to start without
# an explicit non-devnet RPC_URL and an ADMIN_TOKEN (src/config.ts).
NODE_ENV=
# Product VPS only (ops/up.sh): mainnet or devnet. Must match RPC_URL.
# AOF_CLUSTER=
PORT=
LOG_LEVEL=
# development only: include stack traces in error responses
EXPOSE_ERROR_STACK=
# Comma-separated list of allowed browser origins (src/server.ts)
CORS_ORIGIN=

# ---------------------------------------------------------------------------
# Solana
# ---------------------------------------------------------------------------
# Production: must be a mainnet(-grade) RPC; devnet/localhost are rejected.
RPC_URL=
# [#103] Кворум независимых RPC для решений, ведущих к подписи (минты, выплаты,
# co-sign): либы/роуты читают Config/MaterialMints через fetchOneForSigner().
# Формат: через запятую >=2 URL РАЗНЫХ провайдеров (два URL одного хоста
# отвергаются как не дающие независимости). Чтение — всегда finalized.
# В production без этих переменных подписывающие чтения fail-closed (503) —
# так задумано: один RPC-источник правды = один источник лжи (KelpDAO #103).
#RPC_QUORUM_URLS=https://rpc-a.example.com,https://rpc-b.example.com
#RPC_QUORUM_MIN_AGREEMENT=2
# Явное ослабление fail-closed (только вне production): SIGNER_RPC_QUORUM_REQUIRED=false
# aof_core program id. Canonical id: okiLaCvFyHqFRFf359emmunPKD77uUmLQ2iJWskZdnx
PROGRAM_ID=
# Authority key custody [AUDIT AOF-H1] — the gate in src/security/authorityGate.ts
# refuses misconfigured starts (fail closed):
#   AUTHORITY_MODE=hot        — backend holds AUTHORITY_SECRET_KEY (devnet posture).
#                               In production the backend REFUSES to start unless
#                               ALLOW_HOT_AUTHORITY_KEY=1 is set explicitly (a
#                               documented, reviewable transition risk).
#   AUTHORITY_MODE=read-only  — the REQUIRED production posture until Squads/KMS
#                               is wired up: AUTHORITY_SECRET_KEY must be ABSENT
#                               from this environment entirely, AUTHORITY_PUBKEY
#                               is required, and every authority-signing attempt
#                               returns 503.
AUTHORITY_MODE=
# hot mode only — secret manager, never in git; MUST NOT be set in read-only
#AUTHORITY_SECRET_KEY=<base58 secret key>
# read-only mode: the on-chain authority public key (PDA derivation / accounts)
#AUTHORITY_PUBKEY=<base58 pubkey>
# production hot mode only — explicit acknowledgment of the hot-key risk
#ALLOW_HOT_AUTHORITY_KEY=1
# Treasury wallet that receives fees (must equal Config.treasury on-chain)
TREASURY_PUBKEY=
# Fail-closed feature flag; ignored (always false) in production builds.
MINING_ENABLED=
# Operator-selected u32 Season PDA for VIP status. This ID alone is not an
# entitlement: /season/current verifies the on-chain start and 42-day window;
# missing/expired/RPC-unavailable values return 503. VIP reads also require
# EXPECTED_GENESIS_HASH below even in devnet staging. Rotate after initiating
# and verifying the next season. Do not hardcode the first season in the UI.
ACTIVE_SEASON_ID=
# Paid season-pass API sales fail closed by default. Enable only after reward,
# benefit, bytecode and smoke acceptance; the frontend release gate is separate.
PAID_PASS_SALES_ENABLED=false

# ---------------------------------------------------------------------------
# Database (Prisma)
# ---------------------------------------------------------------------------
# prisma/schema.prisma uses the sqlite provider. Point this at a per-environment
# file OUTSIDE the repository. See docs/DATABASE_MIGRATIONS.md.
# SQLite is single-writer: keep connection_limit=1 so concurrent requests queue
# on one connection instead of failing with "database is locked" (Prisma's own
# SQLite guidance). The idempotency CAS relies on P2002 unique violations.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Auth / security
# ---------------------------------------------------------------------------
# Operator bearer token for /admin/* (src/middleware/adminAuth.ts). Required in
# production. Grants authority signing / config mutation.
ADMIN_TOKEN=
# Optional read-only admin token (audit logs, economy snapshots, security stats,
# every GET under /admin/audit, /admin/economy, /security). Must differ from
# ADMIN_TOKEN and be >= 32 chars. Give this one to analysts and dashboards.
ADMIN_READ_TOKEN=
# Trusted reverse-proxy hops (nginx/Caddy/LB) in front of Express. Required in
# production. 1 = one proxy sets X-Forwarded-For; 0 = app exposed directly.
# Never set higher than the real number of hops: clients could spoof req.ip
# and bypass per-IP rate limits.
TRUST_PROXY_HOPS=
# Per-IP throttles (src/middleware/rateLimit.ts). Defaults: general 900 req /
# 15 min, tx 120 req / min, read 1500 req / 15 min. The client polls farm
# panels every 5 s, so keep the general limit >= ~600 / 15 min per player
# behind one IP. The store is per process: with N replicas use a shared store.
# RATE_LIMIT_GENERAL_MAX=900
# RATE_LIMIT_TX_MAX=120
# RATE_LIMIT_READ_MAX=1500
# Read cache for the public /query/* chain reads (src/lib/decode.ts). 0 = no
# staleness but concurrent identical reads still share one RPC call; 2000 is
# invisible to players (panels poll every 5 s) and roughly halves RPC traffic.
# Write paths never use the cache.
# QUERY_CACHE_TTL_MS=2000
# QUERY_CACHE_MAX_ENTRIES=5000
# Secret mixed into device fingerprints (src/lib/antifraud.ts) so raw header
# combinations cannot be precomputed. Rotating it resets device history.
FINGERPRINT_SALT=
# NOTE: /admin/send-tx, /admin/test-grant*, /admin/mint-resource respond 404
# when NODE_ENV=production regardless of token.
# Domain prefix mixed into wallet-proof messages; must match VITE_WALLET_PROOF_DOMAIN.
WALLET_PROOF_DOMAIN=
# Directory where session-key material is stored (src/lib/sessionKeys.ts).
# Must be outside the repo and not world-readable.
SESSION_KEYSTORE_DIR=
# [SECURITY_CHECKLIST #65] 32-byte key (base64 or hex) encrypting session keys at rest.
# Load it from a KMS/secret manager; without it no session key is ever created.
SESSION_KEYSTORE_KEY=

# ---------------------------------------------------------------------------
# Workers (services/*)
# ---------------------------------------------------------------------------
# indexer websocket port
WS_PORT=
# indexer / price tracker reuse RPC_URL above (no more hard-coded localhost)
# chain-indexer (services/chain-indexer): on-chain event ledger
FORWARD_INTERVAL_MS=
BACKFILL_ENABLED=
BACKFILL_PAGE=
INDEXER_HEALTH_PORT=
# Salt for ChainEvent.walletHash (public/aggregate surfaces). Rotating it
# breaks joins across old/new rows; pick once.
WALLET_HASH_SALT=
# trust-worker -> backend base URL (compose: http://backend:8080). The worker
# authenticates to /trust/snapshot/update with ADMIN_TOKEN above.
BACKEND_URL=
# price-cranker interval (ms)
CRANK_INTERVAL_MS=
# farm-trader: anything but "false" keeps the trader in simulation mode
FARM_TRADER_SIMULATION=

# Required in production; obtain with solana genesis-hash against the approved RPC.
# Validated before signing workers start. Never use a value from an untrusted endpoint.
EXPECTED_GENESIS_HASH=
# Use a unique WALLET_PROOF_DOMAIN per cluster/deployment; mirror in the frontend.

# --- Anti-fraud review queue (src/lib/fraudSignals.ts; review-only, no auto-ban) ---
# FRAUD_SCAN_INTERVAL_MIN=15          # 0 disables the periodic scan
# FRAUD_SCAN_WINDOW_HOURS=24
# FRAUD_FRESH_WALLET_HOURS=24
# FRAUD_FRESH_WALLET_MIN_REWARDS=5
# FRAUD_REWARD_VELOCITY_PER_HOUR=12
# FRAUD_SHARED_PAYER_MIN_WALLETS=4
# FRAUD_DEVICE_CLUSTER_MIN_USERS=3
# FRAUD_WASH_MIN_ROUND_TRIPS=3

# --- [F-06] Slot-hash settlement ---
# SWITCHBOARD_CLUSTER is not a randomness source. Leave it empty.
SWITCHBOARD_CLUSTER=
# Circuit breaker: the commit routes refuse new paid commits (503
# VRF_SETTLEMENT_DEGRADED) while any pool slot has been locked longer than this.
# VRF_MAX_PENDING_SLOTS=450
# Several backend replicas: give each one VRF_POOL_SHARD=i/n (0/2, 1/2, ...)
# so they prefer disjoint pool slots instead of racing (VrfSlotBusy).
# VRF_POOL_SHARD=
# Public address lookup table used by atomic v0 exploration commit/reveal/refund
# transactions. Provision/read it on devnet with `npm run vrf:lut:init`; the
# script appends the table address to aof_backend/.env and never freezes/deactivates it.
VRF_ADDRESS_LOOKUP_TABLE=
# Compute budget of reveal / pool transactions.
# VRF_COMPUTE_UNITS=400000
# Priority fee for VRF transactions, microlamports per CU (default 5000,
# capped at 100000 by the wallet guard; 0 disables it).
# VRF_PRIORITY_MICROLAMPORTS=5000
# Do not set AOF_RANDOMNESS. ops/up.sh refuses it. The program reads SlotHashes.
# AOF_RANDOMNESS=
# SWITCHBOARD_GATEWAY_RPC_URL is not used for settlement. Leave it unset.
# SWITCHBOARD_GATEWAY_RPC_URL=
# vrf-settler worker (services/vrf-settler): poll interval and per-commit retry
# throttle. It settles from SlotHashes; it does not ask an oracle.
# VRF_SETTLER_INTERVAL_MS=3000
# VRF_SETTLER_RETRY_MS=4000
# VRF_SETTLER_MIN_AGE_SLOTS=2
# Parallel settlements, exponential backoff ceiling for a failing commit,
# low-balance warning threshold of the settler wallet (lamports) and the
# watchdog that restarts a stuck worker.
# VRF_SETTLER_CONCURRENCY=8
# VRF_SETTLER_MAX_BACKOFF_MS=60000
# VRF_SETTLER_MIN_BALANCE_LAMPORTS=500000000
# VRF_SETTLER_WATCHDOG_MS=120000
# Settler signer: a fee-only wallet, NOT the operator key (reveal and refund
# are permissionless). Required in production, as a Docker secret file; the
# settler then runs with AUTHORITY_MODE=read-only (docker-compose.secrets.yml).
# Base58 or the JSON array written by solana-keygen.
# VRF_SETTLER_SECRET_KEY_FILE=/run/secrets/vrf_settler_secret_key
# Standby settler on a second host (own wallet and RPC): acts only on commits
# older than this many slots, i.e. when the primary is down. Keep it well below
# VRF_MAX_PENDING_SLOTS; 0 (default) = primary.
# VRF_SETTLER_STANDBY_SLOTS=120
