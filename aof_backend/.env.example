# aof_backend environment template.
# Copy to .env and fill in the values. NEVER commit .env (.gitignore covers it).
# No value below is a real secret; everything marked <...> must be provided.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# development | production. In production the backend refuses to start without
# an explicit non-devnet RPC_URL and an ADMIN_TOKEN (src/config.ts).
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
# development only: include stack traces in error responses
EXPOSE_ERROR_STACK=false
# Comma-separated list of allowed browser origins (src/server.ts)
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Solana
# ---------------------------------------------------------------------------
# Production: must be a mainnet(-grade) RPC; devnet/localhost are rejected.
RPC_URL=https://api.devnet.solana.com
# aof_core program id. Canonical id: HtJg3R3Ki938QeSD98djwMgWESboDVEykuyKGtvRamEq
PROGRAM_ID=HtJg3R3Ki938QeSD98djwMgWESboDVEykuyKGtvRamEq
# base58-encoded secret key of the program authority (co-signer for
# authority-gated instructions). Keep in a secret manager, never in git.
AUTHORITY_SECRET_KEY=<base58 secret key>
# Treasury wallet that receives fees (must equal Config.treasury on-chain)
TREASURY_PUBKEY=<pubkey>
# Fail-closed feature flag; ignored (always false) in production builds.
MINING_ENABLED=false

# ---------------------------------------------------------------------------
# Database (Prisma)
# ---------------------------------------------------------------------------
# prisma/schema.prisma uses the sqlite provider. Point this at a per-environment
# file OUTSIDE the repository. See docs/DATABASE_MIGRATIONS.md.
# SQLite is single-writer: keep connection_limit=1 so concurrent requests queue
# on one connection instead of failing with "database is locked" (Prisma's own
# SQLite guidance). The idempotency CAS relies on P2002 unique violations.
DATABASE_URL=file:../data/aof-dev.db?connection_limit=1

# ---------------------------------------------------------------------------
# Auth / security
# ---------------------------------------------------------------------------
# Operator bearer token for /admin/* (src/middleware/adminAuth.ts). Required in
# production. Grants authority signing / config mutation.
ADMIN_TOKEN=<long random string>
# Optional read-only admin token (audit logs, economy snapshots, security stats,
# every GET under /admin/audit, /admin/economy, /security). Must differ from
# ADMIN_TOKEN and be >= 32 chars. Give this one to analysts and dashboards.
ADMIN_READ_TOKEN=<different long random string>
# Trusted reverse-proxy hops (nginx/Caddy/LB) in front of Express. Required in
# production. 1 = one proxy sets X-Forwarded-For; 0 = app exposed directly.
# Never set higher than the real number of hops: clients could spoof req.ip
# and bypass per-IP rate limits.
TRUST_PROXY_HOPS=1
# Secret mixed into device fingerprints (src/lib/antifraud.ts) so raw header
# combinations cannot be precomputed. Rotating it resets device history.
FINGERPRINT_SALT=<random string>
# NOTE: /admin/send-tx, /admin/test-grant*, /admin/mint-resource respond 404
# when NODE_ENV=production regardless of token.
# Domain prefix mixed into wallet-proof messages; must match VITE_WALLET_PROOF_DOMAIN.
WALLET_PROOF_DOMAIN=AOF_API
# Directory where session-key material is stored (src/lib/sessionKeys.ts).
# Must be outside the repo and not world-readable.
SESSION_KEYSTORE_DIR=../data/session-keys

# ---------------------------------------------------------------------------
# Workers (services/*)
# ---------------------------------------------------------------------------
# indexer websocket port
WS_PORT=8081
# indexer / price tracker reuse RPC_URL above (no more hard-coded localhost)
# chain-indexer (services/chain-indexer): on-chain event ledger
FORWARD_INTERVAL_MS=15000
BACKFILL_ENABLED=true
BACKFILL_PAGE=200
INDEXER_HEALTH_PORT=8082
# Salt for ChainEvent.walletHash (public/aggregate surfaces). Rotating it
# breaks joins across old/new rows; pick once.
WALLET_HASH_SALT=<random string>
# trust-worker -> backend base URL (compose: http://backend:8080). The worker
# authenticates to /trust/snapshot/update with ADMIN_TOKEN above.
BACKEND_URL=http://localhost:8080
# price-cranker interval (ms)
CRANK_INTERVAL_MS=60000
# farm-trader: anything but "false" keeps the trader in simulation mode
FARM_TRADER_SIMULATION=true

# Required in production; obtain with solana genesis-hash against the approved RPC.
# Validated before signing workers start. Never use a value from an untrusted endpoint.
EXPECTED_GENESIS_HASH=
# Use a unique WALLET_PROOF_DOMAIN per cluster/deployment; mirror in the frontend.

# --- Anti-fraud review queue (src/lib/fraudSignals.ts; review-only, no auto-ban) ---
# FRAUD_SCAN_INTERVAL_MIN=15          # 0 disables the periodic scan
# FRAUD_SCAN_WINDOW_HOURS=24
# FRAUD_FRESH_WALLET_HOURS=24
# FRAUD_FRESH_WALLET_MIN_REWARDS=5
# FRAUD_REWARD_VELOCITY_PER_HOUR=12
# FRAUD_SHARED_PAYER_MIN_WALLETS=4
# FRAUD_DEVICE_CLUSTER_MIN_USERS=3
# FRAUD_WASH_MIN_ROUND_TRIPS=3
