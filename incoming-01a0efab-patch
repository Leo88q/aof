+++ b/tests/readiness/dead-fail-closed-codes.test.cjs
@@ -0,0 +1,98 @@
+'use strict';
+/**
+ * Таблица отказов для игрока не должна пополняться мёртвыми кодами.
+ *
+ * Зачем гейт. `frontend/src/i18n/apiErrorCopy.ts` — единственный словарь
+ * «почему кнопка не работает», и он уже дважды переживал механики, которые
+ * включали: `HOT_MARKET_DISABLED_UNTIL_CANONICAL_TOOL_TRANSFER`,
+ * `TOOL_GRANT_DISABLED_UNTIL_ACCOUNT_MAP_IS_IMPLEMENTED`,
+ * `REBIRTH_DISABLED_UNTIL_FULL_RESET_IMPLEMENTED`,
+ * `LOTTERY_PURCHASE_REQUIRES_BOUNDED_PRICE`. Каждый такой код — обещание
+ * игроку, что механика закрыта; если его больше никто не возвращает, обещание
+ * ложное и живёт в семи языках.
+ *
+ * Правило: каждый код обязан встречаться как минимум в одном месте, где он
+ * может быть возвращён или обработан (backend, программы, сервисы, тесты), а не
+ * только в самой таблице. Если код нужен для внешнего источника — он
+ * добавляется в ALLOWLIST с причиной, чтобы решение было видно в ревью.
+ */
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const test = require('node:test');
+
+const root = path.resolve(__dirname, '..', '..');
+const TABLE = 'frontend/src/i18n/apiErrorCopy.ts';
+
+/** Коды, которые намеренно живут только в таблице. Причина обязательна. */
+const ALLOWLIST = new Map([]);
+
+const SKIP_DIRS = new Set([
+  'node_modules', '.git', 'dist', 'build', 'target', '.next', 'coverage',
+  'out', '.cache', '.vite', '.turbo', '__pycache__',
+]);
+const CODE_SUFFIXES = new Set([
+  '.ts', '.tsx', '.rs', '.py', '.mjs', '.cjs', '.js', '.json', '.toml', '.yml', '.yaml',
+]);
+
+/** Все коды из таблицы (в порядке объявления). */
+function tableCodes(source) {
+  const start = source.indexOf('export const apiErrorCodes = [');
+  assert.notEqual(start, -1, 'не найден список apiErrorCodes');
+  const end = source.indexOf('] as const;', start);
+  assert.notEqual(end, -1, 'не найден конец списка apiErrorCodes');
+  return [...source.slice(start, end).matchAll(/'([^']+)'/g)].map((match) => match[1]);
+}
+
+/** Текст всего репозитория, кроме самой таблицы, каталогов сборки и снапшотов. */
+function repoCorpus() {
+  const chunks = [];
+  const walk = (dir) => {
+    for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
+      if (entry.isDirectory()) {
+        if (SKIP_DIRS.has(entry.name)) continue;
+        walk(path.join(dir, entry.name));
+        continue;
+      }
+      if (!entry.isFile()) continue;
+      const suffix = path.extname(entry.name);
+      if (!CODE_SUFFIXES.has(suffix)) continue;
+      const relative = path.relative(root, path.join(dir, entry.name));
+      if (relative === TABLE) continue;
+      try {
+        chunks.push(fs.readFileSync(path.join(dir, entry.name), 'utf8'));
+      } catch {
+        // Бинарный или недоступный файл — не повод падать: важны коды, а не он.
+      }
+    }
+  };
+  walk(root);
+  return chunks.join('\n');
+}
+
+test('в таблице отказов нет кодов, которые никто не может вернуть', () => {
+  const source = fs.readFileSync(path.join(root, TABLE), 'utf8');
+  const codes = tableCodes(source);
+  assert.ok(codes.length >= 40, `в таблице только ${codes.length} кодов — проверьте парсер`);
+
+  const corpus = repoCorpus();
+  const allowlisted = new Set();
+  for (const [code, reason] of ALLOWLIST) {
+    assert.ok(typeof reason === 'string' && reason.trim().length > 10,
+      `${code}: в ALLOWLIST нужна причина, иначе запись бессмысленна`);
+    allowlisted.add(code);
+  }
+  const dead = codes.filter((code) => !corpus.includes(code) && !allowlisted.has(code));
+  assert.deepEqual(dead, [],
+    'эти коды есть только в таблице: либо механика снова работает и код надо убрать, ' +
+    'либо он возвращается извне — тогда добавьте его в ALLOWLIST гейта с причиной');
+});
+
+test('в списке кодов нет повторов и пустых значений', () => {
+  const source = fs.readFileSync(path.join(root, TABLE), 'utf8');
+  const codes = tableCodes(source);
+  assert.equal(new Set(codes).size, codes.length, 'дубликаты в apiErrorCodes');
+  for (const code of codes) {
+    assert.match(code, /^[A-Z][A-Z0-9_]{4,}$/, `подозрительный код: ${code}`);
+  }
+});
diff --git a/tests/readiness/dev-local-services.test.cjs b/tests/readiness/dev-local-services.test.cjs
new file mode 100644
index 0000000..ec965dc
--- /dev/null
+++ b/tests/readiness/dev-local-services.test.cjs
@@ -0,0 +1,103 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { spawnSync } = require('node:child_process');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const root = path.resolve(__dirname, '../..');
+
+// `WITH_SERVICES=1 bash scripts/dev-local.sh up` поднимает сервисы backend,
+// которые наполняют БД для истории, квестов, графиков цен и траста. Проверять
+// это глазами дорого (нужны node_modules, RPC и БД), поэтому проверяем сам
+// механизм: поддельный `npm` в PATH, временный каталог вместо aof_backend.
+//
+// Что именно проверяется:
+//   * живость подтверждается, а не предполагается: упавший сервис помечается
+//     как не поднявшийся и его лог печатается;
+//   * живой сервис получает «✓»;
+//   * неизвестное имя сервиса — предупреждение, а не тихий пропуск;
+//   * `Ctrl+C` (SIGTERM по pid'ам из SVC_PIDS) гасит сервисы, а не оставляет их
+//     висеть после выхода;
+//   * скрипт остаётся совместимым с bash 3.2 на macOS (это проверяет
+//     bringup-entrypoints.test.cjs, здесь — только поведение).
+
+const SCRIPT = path.join(root, 'scripts/dev-local.sh');
+
+/** Гасит поддельные сервисы: иначе тест оставит висеть свои же `sleep`. */
+function killPids(list) {
+  for (const pid of String(list).trim().split(/\s+/).filter(Boolean)) {
+    try { process.kill(Number(pid), 'SIGTERM'); } catch { /* уже вышел */ }
+  }
+}
+
+/** Прогоняет start_services с поддельным npm и возвращает {stdout, stderr, code, dir}. */
+function runServices(services, { fakeNpm }) {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'aof-services-'));
+  const bin = path.join(dir, 'bin');
+  fs.mkdirSync(bin, { recursive: true });
+  fs.mkdirSync(path.join(dir, 'be', 'data', 'logs'), { recursive: true });
+  const npmPath = path.join(bin, 'npm');
+  fs.writeFileSync(npmPath, fakeNpm, { mode: 0o755 });
+
+  // Скрипт завершается сам: usage() вызывается диспетчером при аргументе help,
+  // после чего мы зовём настоящие функции — так тест проверяет живой код, а не
+  // его копию.
+  const program = [
+    `source ${JSON.stringify(SCRIPT)} help >/dev/null`,
+    `BE=${JSON.stringify(path.join(dir, 'be'))}`,
+    `SERVICE_WAIT=1`,
+    `SERVICES=${JSON.stringify(services)}`,
+    'start_services',
+    'printf "PIDS:%s\\n" "${SVC_PIDS[*]:-}"',
+  ].join('\n');
+
+  // spawnSync, а не execFileSync: предупреждения скрипт печатает в stderr, и
+  // при успешном exit-коде execFileSync их не возвращает вовсе.
+  const result = spawnSync('bash', ['-c', program], {
+    encoding: 'utf8',
+    env: { ...process.env, PATH: `${bin}:${process.env.PATH}`, HOME: dir },
+    stdio: ['ignore', 'pipe', 'pipe'],
+  });
+  return { stdout: result.stdout || '', stderr: result.stderr || '', code: result.status ?? 1, dir };
+}
+
+const aliveNpm = `#!/usr/bin/env bash
+# Живой сервис: печатает и висит, как настоящий ts-node.
+echo "started $*"
+sleep 5
+`;
+
+const deadNpm = `#!/usr/bin/env bash
+# Упавший сервис: та же ошибка, что бывает у chain-indexer без RPC_URL.
+echo "Error: [chain-indexer] RPC_URL is required" >&2
+exit 1
+`;
+
+test('живой сервис подтверждается, упавший — нет', () => {
+  const alive = runServices('chain-indexer,indexer', { fakeNpm: aliveNpm });
+  assert.equal(alive.code, 0, `start_services упал: ${alive.stderr}`);
+  assert.match(alive.stdout, /✓ chain-indexer/, 'живой сервис не подтверждён');
+  assert.match(alive.stdout, /✓ indexer/, 'второй живой сервис не подтверждён');
+  const pids = (alive.stdout.match(/PIDS:([^\n]*)/) || [])[1] || '';
+  assert.ok(pids.trim().split(/\s+/).length === 2, `SVC_PIDS не заполнен: "${pids}"`);
+  killPids(pids);
+
+  const dead = runServices('trust-worker', { fakeNpm: deadNpm });
+  assert.doesNotMatch(dead.stdout, /✓ trust-worker/, 'упавший сервис отмечен как поднятый');
+  assert.match(dead.stderr, /не поднялся/, 'нет предупреждения о не поднявшемся сервисе');
+  assert.match(dead.stderr + dead.stdout, /RPC_URL is required/, 'лог сервиса не напечатан — причина останется неизвестной');
+});
+
+test('неизвестное имя сервиса — предупреждение, а не тихий пропуск', () => {
+  const result = runServices('chain-indexer,nonsense', { fakeNpm: aliveNpm });
+  assert.match(result.stderr, /неизвестный сервис 'nonsense'/, 'нет предупреждения о неизвестном сервисе');
+  assert.match(result.stdout, /✓ chain-indexer/, 'живой сервис из того же списка не поднялся');
+  killPids((result.stdout.match(/PIDS:([^\n]*)/) || [])[1] || '');
+});
+
+test('сервисы пишут лог в aof_backend/data/logs (его печатают при сбое)', () => {
+  const result = runServices('trust-worker', { fakeNpm: deadNpm });
+  const log = path.join(result.dir, 'be', 'data', 'logs', 'trust-worker.log');
+  assert.ok(fs.existsSync(log), `нет файла лога ${log}`);
+  assert.match(fs.readFileSync(log, 'utf8'), /RPC_URL is required/, 'лог не содержит causa сбоя');
+});
