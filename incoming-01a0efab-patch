+import { PublicKey } from "@solana/web3.js";
+
+/**
+ * [§3.4] Перерождение: чтение состояния и проверка склада.
+ *
+ * Механика обещает «либо сбрасывается всё, либо ничего». Чтобы это было
+ * правдой не только на словах, интерфейс:
