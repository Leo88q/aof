+#[cfg(test)]
+mod orderbook_v2_quote_tests {
+    use super::*;
+
+    /// Цена в v2 — за ЦЕЛЫЙ ресурс (10^9 атомов), поэтому «0,001 SOL за
+    /// ресурс» выразимо, а эскроу округляется ВВЕРХ: недоплатить на пыли
+    /// округления программа не даёт.
