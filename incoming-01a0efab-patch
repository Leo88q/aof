+fn require_v2_order_inputs(
+    config: &Config,
+    materials: &MaterialMints,
+    mint: &Pubkey,
+    kind: u8,
+    price_lamports_per_whole: u64,
+    amount: u64,
+) -> Result<()> {
+    require_canonical_mint(config, materials, mint, kind)?;
+    require!(amount > 0 && price_lamports_per_whole > 0, AofError::ZeroAmount);
+    Ok(())
+}
