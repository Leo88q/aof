@@ -0,0 +1,160 @@
+/**
+ * [§3.4] Перерождение: полный сброс одной транзакцией.
+ *
+ * Страж держит вместе то, что обязано совпадать, но лежит в четырёх местах:
+ * инструкцию aof-core, ограничение контракта на число сжигаемых аккаунтов,
+ * требование подписи authority в aof-rebirth и дискриминатор, которым кошелёк
+ * узнаёт `do_rebirth` до подписи.
+ */
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+
+const root = path.join(__dirname, '..', '..');
+const read = (file) => fs.readFileSync(path.join(root, file), 'utf8');
+const idl = (name) => JSON.parse(read(`aof_backend/src/idl/${name}.json`));
+
+const fnBody = (source, name) => {
+  const start = source.indexOf(`pub fn ${name}`);
+  assert.notEqual(start, -1, `нет функции ${name}`);
+  let depth = 0;
+  for (let i = source.indexOf('{', start); i < source.length; i += 1) {
+    if (source[i] === '{') depth += 1;
+    if (source[i] === '}') {
+      depth -= 1;
+      if (depth === 0) return source.slice(start, i + 1);
+    }
+  }
+  throw new Error(`незакрытая функция ${name}`);
+};
+
+test('aof-core: reset_for_rebirth сбрасывает прогресс, пропуск и жжёт только канонические ресурсы', () => {
+  const core = idl('aof_core');
+  const instruction = core.instructions.find((ix) => ix.name === 'reset_for_rebirth');
+  assert.ok(instruction, 'reset_for_rebirth отсутствует в IDL: перерождение не соберётся');
+  assert.deepEqual(instruction.accounts.map((a) => a.name), [
+    'config', 'operator', 'user', 'player', 'season', 'season_pass', 'material_mints', 'token_program',
+  ]);
+  assert.deepEqual(instruction.args, [{ name: 'season_id', type: 'u32' }]);
+  assert.ok(core.events.some((e) => e.name === 'RebirthReset'), 'нет события RebirthReset');
+
+  const handler = fnBody(read('aof-core/src/instructions/rebirth_reset.rs'), 'handler');
+  for (const field of ['villagers', 'villagers_available', 'has_tent']) {
+    assert.match(handler, new RegExp(`player\\.${field}\\s*=`), `сброс не трогает Player.${field}`);
+  }
+  for (const field of ['xp', 'claimed_bitmap', 'premium']) {
+    assert.match(handler, new RegExp(`pass\\.${field}\\s*=`), `сброс не трогает SeasonPass.${field}`);
+  }
+  // Коллекции — застейканные NFT, а не прогресс: их счётчик обязан совпадать с
+  // числом экземпляров, иначе collector_unstake сломал бы инвариант.
+  assert.doesNotMatch(handler, /historian_count\s*=|medallion_count\s*=/,
+    'перерождение не имеет права обнулять счётчики застейканных коллекций');
+  // Список — remaining_accounts, поэтому проверки обязаны быть строгими.
+  for (const check of ['is_resource_mint', 'get_associated_token_address', 'spl_token::ID',
+    'TokenState::LEN', 'TokenState::unpack', 'data_owner', 'data_mint', 'ZeroAmount']) {
+    assert.ok(handler.includes(check), `сброс не проверяет ${check}`);
+  }
+  assert.match(handler, /require!\(\s*pairs\.len\(\) % 2 == 0/, 'непарный список аккаунтов должен падать');
+});
+
+test('лимит сжигаемых аккаунтов совпадает в контракте, бэкенде и документации', () => {
+  const constant = read('aof-core/src/constants.rs');
+  const match = constant.match(/REBIRTH_RESET_MAX_RESOURCE_ACCOUNTS: usize = (\d+)/);
+  assert.ok(match, 'нет константы REBIRTH_RESET_MAX_RESOURCE_ACCOUNTS');
+  const limit = Number(match[1]);
+  assert.ok(limit >= 4 && limit <= 32, `лимит ${limit} не влезает в транзакцию или бесполезно мал`);
+
+  const route = read('aof_backend/src/routes/rebirth.ts');
+  assert.match(route, new RegExp(`REBIRTH_RESET_MAX_RESOURCE_ACCOUNTS = ${limit}\\b`),
+    'бэкенд и программа разошлись по пределу пары (mint, token_account)');
+
+  const handler = fnBody(read('aof-core/src/instructions/rebirth_reset.rs'), 'handler');
+  assert.match(handler, /REBIRTH_RESET_MAX_RESOURCE_ACCOUNTS/, 'программа не проверяет предел');
+});
+
+test('aof-rebirth: ребёрт требует подпись authority и не выключен заглушкой', () => {
+  const rebirth = idl('aof_rebirth');
+  const instruction = rebirth.instructions.find((ix) => ix.name === 'do_rebirth');
+  assert.ok(instruction, 'do_rebirth отсутствует в IDL');
+  assert.ok(instruction.accounts.some((a) => a.name === 'authority' && a.signer === true),
+    'do_rebirth обязан требовать подпись authority: иначе бонус достижим без полного сброса');
+
+  const source = read('programs/aof-rebirth/src/instructions/do_rebirth.rs');
+  assert.match(source, /address = rebirth_config\.authority @ RebirthError::Unauthorized/);
+  assert.doesNotMatch(fnBody(source, 'handler'), /require!\(\s*false/,
+    'ребёрт снова закрыт заглушкой: полный сброс существует, держать нельзя');
+  // Цена и кулдаун остаются обязательными: ребёрт не бесплатный и не частый.
+  assert.match(fnBody(source, 'handler'), /rebirth_cost_lamports/);
+  assert.match(fnBody(source, 'handler'), /cooldown_seconds/);
+
+  // Дискриминатор в кошельке обязан совпадать с IDL, иначе валидатор интента
+  // отвергнет настоящую транзакцию (или, что хуже, примет подменённую).
+  const bytes = instruction.discriminator;
+  const intent = read('frontend/src/lib/transactionIntent.ts');
+  const constant = intent.match(/REBIRTH_DO_DISCRIMINATOR = \[([0-9,\s]+)\]/);
+  assert.ok(constant, 'нет REBIRTH_DO_DISCRIMINATOR');
+  assert.deepEqual(constant[1].split(',').map((v) => Number(v.trim())).filter((v) => !Number.isNaN(v)), bytes,
+    'дискриминатор do_rebirth разошёлся с IDL');
+});
+
+test('бэкенд: /rebirth/do подписывается кошельком, требует operator и отдаёт полный список излишков', () => {
+  const route = read('aof_backend/src/routes/rebirth.ts');
+  assert.match(route, /requireWalletProof\("rebirth_do", "user"\)/, 'маршрут без доказательства кошелька');
+  assert.match(route, /requireWalletLimits\("rebirth_do"\)/);
+  assert.match(route, /requireIdempotency/);
+  assert.match(route, /CORE_OPERATOR_NOT_BACKEND_KEY/,
+    'без подписи operator транзакцию пришлось бы собирать вручную, а значит частично');
+  assert.match(route, /REBIRTH_AUTHORITY_NOT_BACKEND_KEY/);
+  assert.match(route, /resetForRebirth\(seasonId\)/, 'нет инструкции полного сброса');
+  assert.match(route, /doRebirth\(\)/, 'нет инструкции ребёрта');
+  assert.match(route, /remainingAccounts/, 'излишки не передаются в сброс');
+  assert.match(route, /r\.get\("\/status\/:user"/, 'нет чтения состояния');
+  assert.doesNotMatch(route, /REBIRTH_DISABLED_UNTIL_FULL_RESET_IMPLEMENTED/,
+    'маршрут всё ещё объявляет перерождение выключенным');
+
+  const proof = read('aof_backend/src/security/walletProof.ts');
+  assert.match(proof, /path: "\/rebirth\/do", subject: "rebirth_do", selector: "user"/,
+    'доказательство кошелька не привязано к маршруту');
+
+  const api = read('frontend/src/lib/api.ts');
+  assert.match(api, /api\.rebirth\.status|rebirth: \{[\s\S]{0,200}status:/, 'фронт не читает статус');
+  assert.match(api, /path: "\/rebirth\/do", subject: "rebirth_do", field: "user"/, 'фронт не подписывает запрос');
+});
+
+test('интерфейс: перерождение больше не заглушка, а панель с проверкой данных сети', () => {
+  const notice = read('frontend/src/components/ui/FeatureDisabledNotice.tsx');
+  const disabledBlock = notice.slice(
+    notice.indexOf('export const DISABLED_MECHANICS = {'),
+    notice.indexOf('} as const;'),
+  );
+  assert.doesNotMatch(disabledBlock, /rebirth/, 'rebirth остался в списке закрытых механик');
+
+  const copy = read('frontend/src/i18n/disabledMechanicCopy.ts');
+  assert.doesNotMatch(copy, /rebirth:/, 'тексты для закрытого rebirth остались');
+  assert.doesNotMatch(copy, /Перерождение временно недоступно/);
+
+  const profile = read('frontend/src/pages/profile/ProfileHome.tsx');
+  assert.match(profile, /<RebirthPanel \/>/, 'профиль не показывает панель перерождения');
+
+  const panel = read('frontend/src/components/RebirthPanel.tsx');
+  assert.match(panel, /verifySurplusOnChain/, 'панель обязана перечитывать излишки из сети');
+  assert.match(panel, /kind: "rebirth"/, 'панель не передаёт намерение в кошелёк');
+
+  const reading = read('frontend/src/lib/rebirthReadings.ts');
+  for (const guard of ['isMintAddress', 'isU64Text', 'tokenAmount', 'getMultipleAccountsInfo']) {
+    assert.ok(reading.includes(guard), `чтение не проверяет ${guard}`);
+  }
+
+  // Семь языков обязаны иметь полный набор текстов, включая причины отказа,
+  // которые приходят из сети кодами.
+  const rebirthCopy = read('frontend/src/i18n/rebirthCopy.ts');
+  for (const reason of [
+    'REBIRTH_PAUSED', 'REBIRTH_AUTHORITY_NOT_BACKEND_KEY', 'CORE_OPERATOR_NOT_BACKEND_KEY',
+    'SEASON_NOT_INITIALIZED', 'REBIRTH_NO_PLAYER_PROGRESS', 'REBIRTH_SEASON_PASS_NOT_FOUND',
+    'REBIRTH_MAX_REACHED', 'REBIRTH_COOLDOWN_ACTIVE', 'REBIRTH_SURPLUS_TOO_LARGE',
+  ]) {
+    const occurrences = rebirthCopy.split(reason).length - 1;
+    assert.ok(occurrences >= 3, `причина ${reason} переведена не на все языки (${occurrences})`);
+  }
+});
