@@ -0,0 +1,103 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { spawnSync } = require('node:child_process');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const root = path.resolve(__dirname, '../..');
+
+// `WITH_SERVICES=1 bash scripts/dev-local.sh up` поднимает сервисы backend,
+// которые наполняют БД для истории, квестов, графиков цен и траста. Проверять
+// это глазами дорого (нужны node_modules, RPC и БД), поэтому проверяем сам
+// механизм: поддельный `npm` в PATH, временный каталог вместо aof_backend.
+//
+// Что именно проверяется:
+//   * живость подтверждается, а не предполагается: упавший сервис помечается
+//     как не поднявшийся и его лог печатается;
+//   * живой сервис получает «✓»;
+//   * неизвестное имя сервиса — предупреждение, а не тихий пропуск;
+//   * `Ctrl+C` (SIGTERM по pid'ам из SVC_PIDS) гасит сервисы, а не оставляет их
+//     висеть после выхода;
+//   * скрипт остаётся совместимым с bash 3.2 на macOS (это проверяет
+//     bringup-entrypoints.test.cjs, здесь — только поведение).
+
+const SCRIPT = path.join(root, 'scripts/dev-local.sh');
+
+/** Гасит поддельные сервисы: иначе тест оставит висеть свои же `sleep`. */
+function killPids(list) {
+  for (const pid of String(list).trim().split(/\s+/).filter(Boolean)) {
+    try { process.kill(Number(pid), 'SIGTERM'); } catch { /* уже вышел */ }
+  }
+}
+
+/** Прогоняет start_services с поддельным npm и возвращает {stdout, stderr, code, dir}. */
+function runServices(services, { fakeNpm }) {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'aof-services-'));
+  const bin = path.join(dir, 'bin');
+  fs.mkdirSync(bin, { recursive: true });
+  fs.mkdirSync(path.join(dir, 'be', 'data', 'logs'), { recursive: true });
+  const npmPath = path.join(bin, 'npm');
+  fs.writeFileSync(npmPath, fakeNpm, { mode: 0o755 });
+
+  // Скрипт завершается сам: usage() вызывается диспетчером при аргументе help,
+  // после чего мы зовём настоящие функции — так тест проверяет живой код, а не
+  // его копию.
+  const program = [
+    `source ${JSON.stringify(SCRIPT)} help >/dev/null`,
+    `BE=${JSON.stringify(path.join(dir, 'be'))}`,
+    `SERVICE_WAIT=1`,
+    `SERVICES=${JSON.stringify(services)}`,
+    'start_services',
+    'printf "PIDS:%s\\n" "${SVC_PIDS[*]:-}"',
+  ].join('\n');
+
+  // spawnSync, а не execFileSync: предупреждения скрипт печатает в stderr, и
+  // при успешном exit-коде execFileSync их не возвращает вовсе.
+  const result = spawnSync('bash', ['-c', program], {
+    encoding: 'utf8',
+    env: { ...process.env, PATH: `${bin}:${process.env.PATH}`, HOME: dir },
+    stdio: ['ignore', 'pipe', 'pipe'],
+  });
+  return { stdout: result.stdout || '', stderr: result.stderr || '', code: result.status ?? 1, dir };
+}
+
+const aliveNpm = `#!/usr/bin/env bash
+# Живой сервис: печатает и висит, как настоящий ts-node.
+echo "started $*"
+sleep 5
+`;
+
+const deadNpm = `#!/usr/bin/env bash
+# Упавший сервис: та же ошибка, что бывает у chain-indexer без RPC_URL.
+echo "Error: [chain-indexer] RPC_URL is required" >&2
+exit 1
+`;
+
+test('живой сервис подтверждается, упавший — нет', () => {
+  const alive = runServices('chain-indexer,indexer', { fakeNpm: aliveNpm });
+  assert.equal(alive.code, 0, `start_services упал: ${alive.stderr}`);
+  assert.match(alive.stdout, /✓ chain-indexer/, 'живой сервис не подтверждён');
+  assert.match(alive.stdout, /✓ indexer/, 'второй живой сервис не подтверждён');
+  const pids = (alive.stdout.match(/PIDS:([^\n]*)/) || [])[1] || '';
+  assert.ok(pids.trim().split(/\s+/).length === 2, `SVC_PIDS не заполнен: "${pids}"`);
+  killPids(pids);
+
+  const dead = runServices('trust-worker', { fakeNpm: deadNpm });
+  assert.doesNotMatch(dead.stdout, /✓ trust-worker/, 'упавший сервис отмечен как поднятый');
+  assert.match(dead.stderr, /не поднялся/, 'нет предупреждения о не поднявшемся сервисе');
+  assert.match(dead.stderr + dead.stdout, /RPC_URL is required/, 'лог сервиса не напечатан — причина останется неизвестной');
+});
+
+test('неизвестное имя сервиса — предупреждение, а не тихий пропуск', () => {
+  const result = runServices('chain-indexer,nonsense', { fakeNpm: aliveNpm });
+  assert.match(result.stderr, /неизвестный сервис 'nonsense'/, 'нет предупреждения о неизвестном сервисе');
+  assert.match(result.stdout, /✓ chain-indexer/, 'живой сервис из того же списка не поднялся');
+  killPids((result.stdout.match(/PIDS:([^\n]*)/) || [])[1] || '');
+});
+
+test('сервисы пишут лог в aof_backend/data/logs (его печатают при сбое)', () => {
+  const result = runServices('trust-worker', { fakeNpm: deadNpm });
+  const log = path.join(result.dir, 'be', 'data', 'logs', 'trust-worker.log');
+  assert.ok(fs.existsSync(log), `нет файла лога ${log}`);
+  assert.match(fs.readFileSync(log, 'utf8'), /RPC_URL is required/, 'лог не содержит causa сбоя');
+});
