@@ -0,0 +1,56 @@
+/**
+ * Сцены стенда сайта. Каждая картинка нарисована под палитру A (графит,
+ * циан #5FC9DA, маджента-награда) и лежит рядом с прочими фонами игры.
+ *
+ * Сцена — только фон: она не несёт ни одного числа и не заменяет показания.
+ * Поэтому таблица читается по маршруту, а не по данным бэкенда.
+ */
+
+export type SceneryId = 'hall' | 'console' | 'bay' | 'forge' | 'market' | 'vault';
+
+export const SITE_SCENERY: Record<SceneryId, string> = {
+  hall: '/assets/site/hall.jpg',
+  console: '/assets/site/console.jpg',
+  bay: '/assets/site/bay.jpg',
+  forge: '/assets/site/forge.jpg',
+  market: '/assets/site/market.jpg',
+  vault: '/assets/site/vault.jpg',
+};
+
+const PAGE_SCENERY: Record<string, SceneryId> = {
+  home: 'hall',
+  world: 'hall',
+  lore: 'hall',
+  start: 'console',
+  guide: 'console',
+  glossary: 'console',
+  docs: 'console',
+  rules: 'console',
+  faq: 'console',
+  strategies: 'console',
+  energy: 'bay',
+  weather: 'bay',
+  manifesto: 'bay',
+  roadmap: 'bay',
+  craft: 'forge',
+  tools: 'forge',
+  mine: 'forge',
+  recipes: 'forge',
+  market: 'market',
+  packs: 'market',
+  lottery: 'market',
+  economy: 'market',
+  trade: 'market',
+  quests: 'vault',
+  seasons: 'vault',
+  trust: 'vault',
+  investors: 'vault',
+  potato: 'vault',
+  resources: 'vault',
+};
+
+export function sceneryForPage(id: string): SceneryId {
+  return PAGE_SCENERY[id] ?? 'console';
+}
+
+
