@@ -0,0 +1,166 @@
+import { useCallback, useEffect, useRef, useState } from "react";
+import { useLocale } from "../i18n/LocaleProvider";
+import { gasTankCopy } from "../i18n/gasTankCopy";
+import { useWalletStr } from "../lib/useWalletStr";
+import { api } from "../lib/api";
+import { handleTxResponse } from "../lib/txFlow";
+import { actionErrorFeedback } from "../lib/txResponseFeedback";
+import { solToLamports } from "../lib/amounts";
+import {
+  COOLDOWN_SECONDS, FEE_PER_NFT_MICROS, MIN_DEPOSIT_LAMPORTS,
+  microsToSol, readGasTank, solToMicros, unstakesAffordable, type GasTankReading,
+} from "../lib/gasTank";
+import { Key, Keys, Note, Panel, Readout, Readouts, Row, Rows, Sticker, Lamp } from "../ui/forge/kit";
+
+/**
+ * Панель газ-бака.
+ *
+ * Дефект: механика полностью живая (инструкции `deposit_gas`/`withdraw_gas`,
+ * маршруты `/gastank/deposit`, `/gastank/withdraw`, чтение `/query/gastank`),
+ * но в интерфейсе её не было: бак был виден только числом в «Лаборатории», а
+ * снятие инструмента и разлок коллекционера упирались в пустой бак, который
+ * нельзя пополнить. Здесь появляется единственный честный путь:
+ *   • баланс — только из сети, «—» вместо нуля при сбое чтения;
+ *   • сумма вводится в SOL и переводится в единицы контракта BigInt-ом
+ *     (депозит — лампорты, вывод — микро), без parseFloat;
+ *   • кошелёк подписывает ровно ту сумму, которую игрок видит (GasTankIntent);
+ *   • крупный вывод (> 0.2 SOL) честно предупреждает про кулдаун 12 ч.
+ */
+export function GasTankPanel({ onChanged }: { onChanged?: () => void }) {
+  const { language } = useLocale();
+  const copy = gasTankCopy[language];
+  const address = useWalletStr();
+  const [reading, setReading] = useState<GasTankReading | null>(null);
+  const [amount, setAmount] = useState("");
+  const [busy, setBusy] = useState<"deposit" | "withdraw" | null>(null);
+  const [notice, setNotice] = useState<{ kind: "ok" | "err"; text: string } | null>(null);
+  const ownerRef = useRef<string | null>(null);
+
+  const load = useCallback(async () => {
+    if (!address) { setReading(null); return; }
+    const result = await readGasTank(address);
+    // Смена кошелька не должна оставить чужой баланс на экране.
+    if (ownerRef.current !== address) return;
+    setReading(result);
+  }, [address]);
+
+  useEffect(() => {
+    ownerRef.current = address;
+    setAmount("");
+    setNotice(null);
+    setReading(null);
+    if (!address) return;
+    load();
+    const timer = setInterval(load, 15_000);
+    return () => clearInterval(timer);
+  }, [address, load]);
+
+  const balance = reading?.kind === "ready" ? reading.balanceMicros : null;
+  const cooldownLeft = reading?.kind === "ready" && reading.cooldownUntil * 1000 > Date.now()
+    ? Math.ceil((reading.cooldownUntil * 1000 - Date.now()) / 60_000)
+    : 0;
+
+  function parsedAmount() {
+    try {
+      const micros = solToMicros(amount);
+      solToLamports(amount); // та же строка должна быть точной и в лампортах
+      return micros;
+    } catch { return null; }
+  }
+
+  async function send(action: "deposit" | "withdraw") {
+    if (!address) return;
+    const micros = parsedAmount();
+    if (micros === null || micros <= 0n) { setNotice({ kind: "err", text: copy.invalid }); return; }
+    const lamports = BigInt(solToLamports(amount));
+    if (action === "deposit" && lamports < MIN_DEPOSIT_LAMPORTS) { setNotice({ kind: "err", text: copy.minDeposit }); return; }
+    if (action === "withdraw" && balance !== null && micros > balance) { setNotice({ kind: "err", text: copy.insufficient }); return; }
+    setBusy(action);
+    setNotice(null);
+    try {
+      const payload = action === "deposit"
+        ? { user: address, amount: lamports.toString() }
+        : { user: address, amount: micros.toString() };
+      const response: any = action === "deposit"
+        ? await api.gastank.deposit(payload)
+        : await api.gastank.withdraw(payload);
+      const intent = action === "deposit"
+        ? { kind: "gasTank" as const, action: "deposit" as const, user: address, amountLamports: lamports.toString() }
+        : { kind: "gasTank" as const, action: "withdraw" as const, user: address, amountMicros: micros.toString() };
+      const result = await handleTxResponse(response, intent);
+      if (!result.success) {
+        setNotice({ kind: "err", text: result.error || actionErrorFeedback(result.error, language, copy.uncertain) });
+        return;
+      }
+      setNotice({ kind: "ok", text: action === "deposit" ? copy.depositDone : copy.withdrawDone });
+      setAmount("");
+      await load();
+      onChanged?.();
+    } catch (e: any) {
+      setNotice({ kind: "err", text: actionErrorFeedback(e, language, copy.uncertain) });
+    } finally {
+      setBusy(null);
+    }
+  }
+
+  const balanceText = !address ? copy.noWallet
+    : reading === null ? copy.reading
+      : reading.kind === "unknown" ? "—"
+        : reading.kind === "missing" ? "0"
+          : microsToSol(reading.balanceMicros);
+
+  return (
+    <Panel tier="panel" device="cross" id={<Sticker bars>{copy.sticker}</Sticker>}
+      meta={copy.meta} title={copy.title} sub={copy.sub}>
+      <Readouts>
+        <Readout label={copy.balance} value={balanceText} unit={address && reading?.kind === "ready" ? "SOL" : undefined}
+          dash={!address || reading?.kind === "unknown"} hint={copy.balance} />
+        <Readout label={copy.operations} value={balance === null ? undefined : unstakesAffordable(balance).toString()}
+          dash={balance === null} hint={copy.feeHint} />
+      </Readouts>
+      {address && reading?.kind === "missing" && <Note quiet>{copy.balanceMissing}</Note>}
+      {address && reading?.kind === "unknown" && <p role="status" className="fg-note break-words">{copy.balanceUnknown}</p>}
+      {reading?.kind === "ready" && (
+        cooldownLeft > 0
+          ? <p role="status" className="fg-note break-words">{copy.cooldownActive(String(cooldownLeft))}</p>
+          : <Lamp tone="ok">{copy.cooldownReady}</Lamp>
+      )}
+      <Note quiet>{copy.affordable(unstakesAffordable(balance ?? 0n).toString())} · {copy.instantHint}</Note>
+      <Note quiet>{copy.dustHint}</Note>
+
+      {address && (
+        <>
+          <Rows>
+            <Row k={copy.amount} v={
+              <input value={amount} onChange={e => setAmount(e.target.value.replace(/[^\d.]/g, ""))}
+                inputMode="decimal" placeholder="0.05" aria-label={copy.amount}
+                className="fg-input w-28 text-right" />
+            } />
+          </Rows>
+          <Keys>
+            {["0.05", "0.1", "0.5"].map(v => (
+              <Key key={v} tiny disabled={busy !== null} onClick={() => setAmount(v)}>{v}</Key>
+            ))}
+            {balance !== null && balance > 0n && (
+              <Key tiny disabled={busy !== null} onClick={() => setAmount(microsToSol(balance))}>{copy.max}</Key>
+            )}
+          </Keys>
+          <Keys>
+            <Key tone="primary" disabled={busy !== null || !amount} onClick={() => send("deposit")}>
+              {busy === "deposit" ? copy.sending : copy.deposit}
+            </Key>
+            <Key disabled={busy !== null || !amount || balance === null || cooldownLeft > 0} onClick={() => send("withdraw")}>
+              {busy === "withdraw" ? copy.sending : copy.withdraw}
+            </Key>
+          </Keys>
+        </>
+      )}
+      {notice && <p role="status" className={notice.kind === "ok" ? "fg-note break-words" : "fg-note fg-note--err break-words"}>{notice.text}</p>}
+      {!address && <Keys><Key disabled>{copy.connect}</Key></Keys>}
+    </Panel>
+  );
+}
+
+/** Ровно 0.01 SOL — комиссия снятия инструмента и разлока коллекционера. */
+export const GAS_TANK_FEE_MICROS = FEE_PER_NFT_MICROS;
+export const GAS_TANK_COOLDOWN_SECONDS = COOLDOWN_SECONDS;
