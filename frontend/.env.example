# frontend (Vite) environment template. Copy to .env.local; never commit .env*.
# All VITE_* values are embedded into the public bundle - no secrets here.

# Backend API base. Default "/api" assumes the hosting layer proxies /api to aof_backend.
VITE_API_URL=/api
# Dev-server proxy target for /api (vite.config.ts)
VITE_DEV_BACKEND_URL=http://localhost:8080
# Solana RPC. Required for a production build (the build fails without it).
VITE_RPC_URL=https://api.devnet.solana.com
# Market websocket (indexer). Path default "/ws"; URL optional.
VITE_MARKET_WS_PATH=/ws
VITE_MARKET_WS_URL=
# Must match aof_backend WALLET_PROOF_DOMAIN
VITE_WALLET_PROOF_DOMAIN=AOF_API
# Fail-closed feature flag; keep false until the mining flow passes the validator suite
VITE_MINING_ENABLED=false
