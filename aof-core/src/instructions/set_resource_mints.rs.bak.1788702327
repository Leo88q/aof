use anchor_lang::prelude::*;
use crate::SetResourceMints;

/// [ФИКС]: mint_resource/burn_resource читают config.food_mint/wood_mint/
/// stone_mint, но ни одна присланная инструкция их не устанавливала после
/// initialize() (там Pubkey::default()) — mint_resource был бы недоступен
/// в принципе. Добавляю сеттер.
pub fn handler(
    ctx: Context<SetResourceMints>,
    food_mint: Pubkey,
    wood_mint: Pubkey,
    stone_mint: Pubkey,
) -> Result<()> {
    let cfg = &mut ctx.accounts.config;
    cfg.food_mint = food_mint;
    cfg.wood_mint = wood_mint;
    cfg.stone_mint = stone_mint;
    Ok(())
}
