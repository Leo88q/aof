# AOF Watchtower exporter — copy to watchtower/.env (gitignored). No real secrets in Git.
WATCHTOWER_EXPORTER_PORT=8790
WATCHTOWER_EXPORTER_TOKEN=            # bearer token Watchtower presents; required in production
WATCHTOWER_CLUSTER=devnet
WATCHTOWER_RPC_URL=                   # used ONLY for getSlot("finalized") → finalized lag
WATCHTOWER_RPC_FALLBACK_URL=
WATCHTOWER_DATABASE_URL=              # same DB the aof_backend chain-indexer writes; exporter is read-only. Empty → DATABASE_URL
WATCHTOWER_EVENT_PROVIDER=mock        # mock (empty ledger tolerated by /readyz) | indexer (requires fresh IndexerCursor)
WATCHTOWER_ENABLE_WRITES=false        # must stay false; exporter refuses to start with true
WATCHTOWER_PLAYER_HASH_SALT=          # shared across all games (issued by Watchtower); required in production
WATCHTOWER_STALE_CURSOR_MS=600000     # /readyz reports indexer not ok when the cursor is older than this
TREASURY_PUBKEY=                      # deployment treasury (read from aof_backend/.env in compose)

# Optional observability (all fail open)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_ENABLED=false
REDIS_URL=
