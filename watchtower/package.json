{
  "name": "aof-watchtower-exporter",
  "private": true,
  "description": "Read-only Watchtower exporter for Age of Farming. Depends on aof_backend's node_modules, Prisma client and IDLs; no dependencies of its own.",
  "scripts": {
    "build": "cd ../aof_backend && ./node_modules/.bin/tsc -p ../watchtower/tsconfig.json --outDir ../watchtower/dist",
    "start": "node dist/watchtower/src/watchtower-exporter.js",
    "dev": "cd ../aof_backend && ./node_modules/.bin/ts-node --project ../watchtower/tsconfig.json --transpile-only ../watchtower/src/watchtower-exporter.ts",
    "test": "npm run test:events && npm run test:decoder && npm run test:replay && npm run test:readonly",
    "test:events": "cd ../aof_backend && ./node_modules/.bin/ts-node --project ../watchtower/tsconfig.json --transpile-only ../watchtower/tests/watchtower-events.test.ts",
    "test:decoder": "cd ../aof_backend && ./node_modules/.bin/ts-node --project ../watchtower/tsconfig.json --transpile-only ../watchtower/tests/watchtower-decoder.test.ts",
    "test:replay": "cd ../aof_backend && ./node_modules/.bin/ts-node --project ../watchtower/tsconfig.json --transpile-only ../watchtower/tests/watchtower-replay.test.ts",
    "test:readonly": "cd ../aof_backend && ./node_modules/.bin/ts-node --project ../watchtower/tsconfig.json --transpile-only ../watchtower/tests/watchtower-readonly.test.ts",
    "typecheck": "cd ../aof_backend && ./node_modules/.bin/tsc -p ../watchtower/tsconfig.json --noEmit"
  }
}
