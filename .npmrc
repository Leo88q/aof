# [SECURITY #107] Снабженческая гигиена npm.
# save-exact: новые зависимости фиксируются точной версией. Диапазон ^ сам по себе
# является каналом атаки — свежий (возможно, скомпрометированный) релиз подхватится
# без ревью. Обновления — отдельным PR с разбором diff и задержкой на «отлёжку».
save-exact=true
legacy-peer-deps=true
