# Host shell for backup upload. Not the API environment. Copy the values into
# the crontab environment or a root-only file outside git.
# R2: also set AWS_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# and the R2 token in the aws/rclone config, not in this file.
BACKUP_S3_URI=s3://bucket/aof/mainnet
BACKUP_KEEP=30
