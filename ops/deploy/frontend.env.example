# Public values baked into frontend/dist. Copy to ops/deploy/frontend.env.
# That copy is gitignored. No secrets belong here: the bundle is public.
# VITE_WALLET_PROOF_DOMAIN must equal WALLET_PROOF_DOMAIN in aof_backend/.env.
VITE_API_URL=/api
VITE_RPC_URL=
VITE_WALLET_PROOF_DOMAIN=
VITE_MINING_ENABLED=false
