{
  // [SECURITY #106/#107] Среда для чужого/непроверенного кода (тестовые задания,
  // новые зависимости, внешние навыки агентов). Внутри — только репозиторий:
  // никаких монтирований ~/.ssh, ~/.aws, ~/.config/solana, secrets/ и хостовых .env.
  "name": "NeuroForge sandbox",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22-bookworm",
  "remoteUser": "node",
  "containerEnv": {
    "AUTHORITY_MODE": "read-only",
    "NPM_CONFIG_AUDIT": "false",
    "NPM_CONFIG_FUND": "false",
    // npm ci в песочнице не выполняет install-скрипты пакетов: вредоносный
    // postinstall — основной канал кампаний ChainDrop (август 2026).
    "NPM_CONFIG_IGNORE_SCRIPTS": "true"
  },
  "runArgs": [
    "--cap-drop=ALL",
    "--security-opt=no-new-privileges",
    "--pids-limit=512"
  ],
  "mounts": [],
  "postCreateCommand": "node -v && npm -v",
  // Никаких автозапускаемых задач при открытии папки (#106).
  "customizations": {
    "vscode": {
      "settings": {
        "task.autoDetect": "off",
        "security.workspace.trust.enabled": true,
        "npm.autoDetect": "off"
      }
    }
  }
}
