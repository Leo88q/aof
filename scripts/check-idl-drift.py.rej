+def context_type_name(args_src: str) -> tuple[str, str] | None:
+    """Name of the accounts struct and the remaining argument source.
+
+    Accepts both the plain form and the form Anchor recommends for handlers
+    that touch `ctx.remaining_accounts` (the one whose absence produces
+    "lifetime may not live long enough"):
+
+        ctx: Context<Foo>
+        ctx: Context<'_, '_, '_, 'info, Foo<'info>>
+
+    Без этого послабления гейт IDL объявлял «instruction exists in IDL but
+    not in source» ровно тогда, когда инструкция писалась в рекомендованном
+    Anchor виде. Разбираем скобки вручную: у `Context<...>` внутри есть свои
+    `<>`.
+    """
+    m = re.match(r"\s*ctx\s*:\s*Context\s*<", args_src)
+    if not m:
+        return None
+    rest, depth = args_src[m.end():], 1
+    for i, ch in enumerate(rest):
+        if ch in "<([":
+            depth += 1
+        elif ch in ">)]":
+            depth -= 1
+            if depth == 0:
+                generics, tail = rest[:i], rest[i + 1:]
+                break
+    else:
+        return None
+    # Последний параметр Context — структура аккаунтов; лайфтаймы/генерики у
+    # неё отбрасываем: `ResetForRebirth<'info>` → `ResetForRebirth`.
+    last = generics.rstrip().rstrip(",").rsplit(",", 1)[-1].strip()
+    name = re.match(r"(\w+)", last)
+    if not name:
+        return None
+    # Хвост списка аргументов начинается с запятой, если аргументы ещё есть.
+    return name.group(1), tail
+
+
