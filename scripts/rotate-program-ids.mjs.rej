@@ -0,0 +1,461 @@
+#!/usr/bin/env node
+/**
+ * rotate-program-ids — смена адресов программ там, где её требуют факты.
+ *
+ * Зачем. Создать программу по адресу можно только ключом ЭТОГО адреса: аккаунт
+ * программы подписывает свой деплой. Читающий зонд (`scripts/devnet-program-probe.py`)
+ * показал, что на девнете нет `aof_core`, `aof_market` и `aof_session_keys`, а
+ * ключей, чьи pubkey равны объявленным адресам, у владельца нет. Значит адрес
+ * объявлен, но недостижим, и единственный честный выход — объявить новые адреса
+ * и переписать их ОДНОВРЕМЕННО везде: `declare_id!`, `Anchor.toml`, реестр,
+ * IDL, watchtower, клиенты, тесты, документация. Полумера хуже: сборка и тесты
+ * пройдут, а игра и бэкенд будут звать адрес, которого нет.
+ *
+ * Что делает по умолчанию: ничего не меняет, только показывает план.
+ *
+ *   node scripts/rotate-program-ids.mjs --check
+ *       Гейт: реестр/declare_id!/Anchor.toml/IDL/watchtower/клиенты сходятся,
+ *       ключи (если лежат рядом) соответствуют адресам, в дереве нет адресов
+ *       из history[]. Код выхода 1 при любом расхождении.
+ *
+ *   node scripts/rotate-program-ids.mjs --plan
+ *       Текущее состояние: адрес, есть ли ключ, что будет сгенерировано.
+ *
+ *   node scripts/rotate-program-ids.mjs --generate aof_core,aof_market,aof_session_keys --apply
+ *       Сгенерировать ключи для перечисленных программ (по умолчанию — для тех,
+ *       у кого ключа нет), положить в `solana/keys/programs/<имя>.json` (gitignore)
+ *       и зеркально в `target/deploy/<имя>-keypair.json` (gitignore), затем
+ *       переписать адреса во всех местах.
+ *
+ *   node scripts/rotate-program-ids.mjs --apply --programs aof_core
+ *       Переписать адреса по уже существующим ключам (например, ключ появился
+ *       из бэкапа и адрес в репозитории надо привести к нему).
+ *
+ * Ключи НИКОГДА не коммитятся и не печатаются: в вывод идут только pubkey,
+ * путь и признак «есть/нет». Исторические датированные аудиты не переписываются:
+ * это записи о прошлом состоянии, а не инструкции.
+ *
+ * Переменные окружения:
+ *   KEYS_DIR (по умолчанию solana/keys/programs), ARTIFACTS (по умолчанию target/deploy).
+ */
+import { existsSync, mkdirSync, readFileSync, readdirSync, statSync, writeFileSync, chmodSync } from "node:fs";
+import { execFileSync } from "node:child_process";
+import { createHash, generateKeyPairSync } from "node:crypto";
+import { dirname, join, relative, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+
+const ROOT = resolve(dirname(fileURLToPath(import.meta.url)), "..");
+const KEYS_DIR = process.env.KEYS_DIR || join(ROOT, "solana", "keys", "programs");
+const ARTIFACTS = process.env.ARTIFACTS || join(ROOT, "target", "deploy");
+const REGISTRY = "security/program-registry.json";
+
+/** Программа -> файл с `declare_id!`. Источник истины для адреса в коде. */
+const PROGRAMS = {
+  aof_core: { source: "aof-core/src/lib.rs", idl: "aof_backend/src/idl/aof_core.json" },
+  aof_market: { source: "programs/aof-market/src/lib.rs", idl: "aof_backend/src/idl/aof_market.json" },
+  aof_quests: { source: "programs/aof-quests/src/lib.rs", idl: "aof_backend/src/idl/aof_quests.json" },
+  aof_rebirth: { source: "programs/aof-rebirth/src/lib.rs", idl: "aof_backend/src/idl/aof_rebirth.json" },
+  aof_liquidity: { source: "programs/aof-liquidity/src/lib.rs", idl: "aof_backend/src/idl/aof_liquidity.json" },
+  aof_session_keys: { source: "programs/aof-session-keys/src/lib.rs", idl: "aof_backend/src/idl/aof_session_keys.json" },
+};
+
+/**
+ * Файлы, которые обязаны знать адрес для программы. Проверяются положительно:
+ * «адрес здесь есть» — иначе после смены останется тихий старый вызов.
+ * txGuard и реестр проверяет ещё и program-registry.mjs; здесь они для того,
+ * чтобы смена адреса не могла пройти «наполовину».
+ */
+const REQUIRED = {
+  aof_core: [
+    "Anchor.toml", REGISTRY, "watchtower/addresses.json", "frontend/src/lib/txGuard.ts",
+    "frontend/src/lib/gasTank.ts", "frontend/src/lib/transactionIntent.ts",
+    "aof_backend/.env.example", "docs/SECURITY_RUNBOOK.md", "WATCHTOWER_INTEGRATION.md",
+  ],
+  aof_market: ["Anchor.toml", REGISTRY, "watchtower/addresses.json", "frontend/src/lib/txGuard.ts", "docs/SECURITY_RUNBOOK.md"],
+  aof_quests: ["Anchor.toml", REGISTRY, "watchtower/addresses.json", "frontend/src/lib/txGuard.ts", "docs/SECURITY_RUNBOOK.md"],
+  aof_rebirth: [
+    "Anchor.toml", REGISTRY, "watchtower/addresses.json", "frontend/src/lib/txGuard.ts",
+    "frontend/src/lib/transactionIntent.ts", "docs/SECURITY_RUNBOOK.md",
+  ],
+  aof_liquidity: ["Anchor.toml", REGISTRY, "watchtower/addresses.json", "frontend/src/lib/txGuard.ts", "docs/SECURITY_RUNBOOK.md"],
+  aof_session_keys: ["Anchor.toml", REGISTRY, "watchtower/addresses.json", "frontend/src/lib/txGuard.ts", "docs/SECURITY_RUNBOOK.md"],
+};
+
+/**
+ * Датированные аудиты и чек-листы — свидетельства прошлого состояния.
+ * Переписывать их адресом нового деплоя значит подделывать историю; гейт
+ * пропускает их и печатает, чтобы пропуск был видимым, а не молчаливым.
+ */
+const HISTORICAL = [
+  /^AUDIT_REPORT_\d{4}-\d{2}-\d{2}\.md$/,
+  /^SECURITY_CHECKLIST_AI_AGENTS_\d{4}-\d{2}-\d{2}\.md$/,
+  /^SECURITY_CHECKLIST_REVIEW_\d{4}-\d{2}-\d{2}\.md$/,
+  /^docs\/archive\//,
+];
+
+// --------------------------------------------------------------- base58 -----
+const ALPHABET = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";
+
+function base58(bytes) {
+  let n = 0n;
+  for (const b of bytes) n = (n << 8n) | BigInt(b);
+  let out = "";
+  while (n > 0n) {
+    out = ALPHABET[Number(n % 58n)] + out;
+    n /= 58n;
+  }
+  for (const b of bytes) {
+    if (b !== 0) break;
+    out = "1" + out;
+  }
+  return out;
+}
+
+const isAddress = (s) => typeof s === "string" && /^[1-9A-HJ-NP-Za-km-z]{32,44}$/.test(s);
+
+// ------------------------------------------------------------------ cli -----
+const argv = process.argv.slice(2);
+const has = (flag) => argv.includes(flag);
+function value(flag) {
+  const withEq = argv.find((a) => a.startsWith(`${flag}=`));
+  if (withEq) return withEq.slice(flag.length + 1);
+  const index = argv.indexOf(flag);
+  return index >= 0 && argv[index + 1] && !argv[index + 1].startsWith("--") ? argv[index + 1] : "";
+}
+const check = has("--check");
+const apply = has("--apply");
+const plan = has("--plan") || (!check && !has("--generate") && !apply && !has("--address"));
+const jsonOut = has("--json");
+const wantGenerate = argv.some((a) => a === "--generate" || a.startsWith("--generate="));
+const generateList = wantGenerate ? (value("--generate") || "").split(",").map((s) => s.trim()).filter(Boolean) : [];
+const rotateList = value("--programs").split(",").map((s) => s.trim()).filter(Boolean);
+const explicit = value("--address"); // aof_core=<base58>
+
+const problems = [];
+const notes = [];
+const fail = (msg) => problems.push(msg);
+
+// ---------------------------------------------------------------- helpers ---
+const read = (rel) => readFileSync(join(ROOT, rel), "utf8");
+const exists = (rel) => existsSync(join(ROOT, rel));
+
+function trackedFiles() {
+  try {
+    // --cached --others: смена адресов обязана попасть и в ещё не закоммиченные
+    // файлы (иначе свежий клиент останется со старым адресом), но не в
+    // игнорируемые (ключи, сборка).
+    return execFileSync("git", ["-C", ROOT, "ls-files", "--cached", "--others", "--exclude-standard"], { encoding: "utf8" })
+      .split("\n").map((s) => s.trim()).filter(Boolean)
+      .filter((f) => existsSync(join(ROOT, f)) && statSync(join(ROOT, f)).isFile());
+  } catch {
+    // Без git (tarball/архив) — обходим дерево, исключая тяжёлое и секретное.
+    const skip = new Set(["node_modules", ".git", "target", "dist", "build", ".anchor", "test-ledger", "keys", ".venv", "coverage"]);
+    const out = [];
+    const walk = (dir) => {
+      for (const entry of readdirSync(dir, { withFileTypes: true })) {
+        if (entry.name.startsWith(".") && entry.name !== ".github") continue;
+        if (skip.has(entry.name)) continue;
+        const full = join(dir, entry.name);
+        if (entry.isDirectory()) walk(full);
+        else out.push(relative(ROOT, full).split("\\").join("/"));
+      }
+    };
+    walk(ROOT);
+    return out;
+  }
+}
+
+const isBinary = (buffer) => buffer.includes(0);
+
+function readText(rel) {
+  const buffer = readFileSync(join(ROOT, rel));
+  if (isBinary(buffer)) return null;
+  return buffer.toString("utf8");
+}
+
+function isHistorical(rel) {
+  return HISTORICAL.some((re) => re.test(rel));
+}
+
+/** `declare_id!` конкретного файла. */
+function declaredIn(rel) {
+  const text = readText(rel);
+  const m = text && text.match(/declare_id!\("([1-9A-HJ-NP-Za-km-z]{32,44})"\)/);
+  return m ? m[1] : null;
+}
+
+/** Публичный адрес keypair-файла Solana CLI (64 байта, JSON-массив). */
+function keypairAddress(file) {
+  const bytes = JSON.parse(readFileSync(file, "utf8"));
+  if (!Array.isArray(bytes) || bytes.length !== 64) throw new Error(`${file}: ожидался 64-байтный keypair`);
+  return base58(Uint8Array.from(bytes.slice(32)));
+}
+
+/** Ключ программы: сначала локальное хранилище, затем target/deploy (его ждёт anchor). */
+function keypairPath(name, { mirror = false } = {}) {
+  const local = join(KEYS_DIR, `${name}.json`);
+  if (existsSync(local)) return local;
+  const built = join(ARTIFACTS, `${name}-keypair.json`);
+  if (mirror || existsSync(built)) return mirror ? local : built;
+  return null;
+}
+
+/** Новый ed25519-keypair в формате Solana CLI, без внешних зависимостей. */
+function generateKeypair() {
+  const { privateKey, publicKey } = generateKeyPairSync("ed25519");
+  const seed = privateKey.export({ type: "pkcs8", format: "der" }).subarray(-32);
+  const pub = publicKey.export({ type: "spki", format: "der" }).subarray(-32);
+  const secret = Buffer.concat([Buffer.from(seed), Buffer.from(pub)]);
+  return { secret, address: base58(Uint8Array.from(pub)) };
+}
+
+function writeKeypair(file, secret) {
+  mkdirSync(dirname(file), { recursive: true });
+  writeFileSync(file, JSON.stringify(Array.from(secret)) + "\n", { mode: 0o600 });
+  try { chmodSync(file, 0o600); } catch { /* Windows/ACL — не критично */ }
+}
+
+// ---------------------------------------------------------------- registry --
+const registry = JSON.parse(read(REGISTRY));
+const registryByName = new Map(registry.programs.map((p) => [p.name, p]));
+
+const current = {}; // name -> { declared, registry, keypair, keypairAddress, idl }
+for (const name of Object.keys(PROGRAMS)) {
+  const meta = PROGRAMS[name];
+  const declared = declaredIn(meta.source);
+  const entry = registryByName.get(name);
+  if (!declared) fail(`${meta.source}: нет declare_id!`);
+  if (!entry) fail(`${REGISTRY}: нет записи ${name}`);
+  else if (entry.address !== declared) fail(`${name}: реестр ${entry.address} != declare_id! ${declared}`);
+  let keyPath = null;
+  let keyAddress = null;
+  for (const candidate of [join(KEYS_DIR, `${name}.json`), join(ARTIFACTS, `${name}-keypair.json`)]) {
+    if (!existsSync(candidate)) continue;
+    try {
+      keyAddress = keypairAddress(candidate);
+      keyPath = candidate;
+      break;
+    } catch (error) {
+      fail(`${relative(ROOT, candidate)} не читается как keypair: ${error.message}`);
+    }
+  }
+  current[name] = { declared, entry: entry || null, keypair: keyPath, keypairAddress: keyAddress, idl: meta.idl };
+}
+
+// ------------------------------------------------------- генерация ключей ---
+const changed = new Map(); // name -> newAddress
+if (wantGenerate) {
+  // Безопасность: `--generate` без списка НЕ должен трогать программы, которые
+  // уже живут в сети (их адрес менять нельзя — аккаунт там уже создан). Список
+  // программ задаётся явно или через --programs.
+  if (!generateList.length && !rotateList.length) {
+    const missing = Object.keys(PROGRAMS).filter((name) => !current[name].keypairAddress);
+    fail(`--generate требует список программ: --generate aof_core,aof_market (без ключей сейчас: ${missing.join(", ") || "все с ключами"})`);
+  }
+  const targets = (generateList.length ? generateList : rotateList)
+    .filter((name) => {
+      if (!(name in PROGRAMS)) { fail(`--generate: неизвестная программа '${name}'`); return false; }
+      if (current[name].keypairAddress) {
+        notes.push(`${name}: ключ уже есть (${relative(ROOT, current[name].keypair)}) — генерация пропущена`);
+        return false;
+      }
+      return true;
+    });
+  if (!targets.length) notes.push("--generate: нечего генерировать — у выбранных программ уже есть ключи");
+  for (const name of targets) {
+    const { secret, address } = generateKeypair();
+    const local = join(KEYS_DIR, `${name}.json`);
+    const mirror = join(ARTIFACTS, `${name}-keypair.json`);
+    notes.push(`${name}: новый адрес ${address} (ключ ${relative(ROOT, local)}; секрет не печатается)`);
+    if (apply) {
+      writeKeypair(local, secret);
+      writeKeypair(mirror, secret);
+      current[name].keypair = local;
+      current[name].keypairAddress = address;
+    }
+    if (address !== current[name].declared) changed.set(name, address);
+  }
+}
+
+// --------------------------------------------------- явные адреса (--address)
+if (explicit) {
+  for (const pair of explicit.split(",").map((s) => s.trim()).filter(Boolean)) {
+    const [name, address] = pair.split("=");
+    if (!(name in PROGRAMS)) { fail(`--address: неизвестная программа '${name}'`); continue; }
+    if (!isAddress(address)) { fail(`--address ${name}: '${address}' не похож на base58-адрес`); continue; }
+    if (address !== current[name].declared) changed.set(name, address);
+  }
+}
+
+// --------------------------- программы, у которых ключ есть, а адрес другой --
+if (!wantGenerate && !explicit && rotateList.length) {
+  for (const name of rotateList) {
+    if (!(name in PROGRAMS)) { fail(`--programs: неизвестная программа '${name}'`); continue; }
+    const { keypairAddress: keyAddress, declared } = current[name];
+    if (!keyAddress) { fail(`${name}: ключа нет — сначала --generate ${name}`); continue; }
+    if (keyAddress !== declared) changed.set(name, keyAddress);
+  }
+}
+
+// ------------------------------------------------------------- перезапись ---
+const writePlan = []; // { file, from, to, name }
+if (changed.size) {
+  for (const rel of trackedFiles()) {
+    if (isHistorical(rel)) continue;
+    const text = readText(rel);
+    if (!text) continue;
+    for (const [name, address] of changed) {
+      const old = current[name].declared;
+      if (!old || !text.includes(old)) continue;
+      writePlan.push({ file: rel, from: old, to: address, name });
+    }
+  }
+}
+
+if (apply && changed.size) {
+  const byFile = new Map();
+  for (const item of writePlan) {
+    if (!byFile.has(item.file)) byFile.set(item.file, []);
+    byFile.get(item.file).push(item);
+  }
+  for (const [rel, items] of byFile) {
+    let text = read(rel);
+    for (const { from, to } of items) text = text.split(from).join(to);
+    writeFileSync(join(ROOT, rel), text);
+  }
+  // Реестр помнит прошлые адреса: по ним гейт ловит забытый вызов в новом коде.
+  for (const [name, address] of changed) {
+    const entry = registryByName.get(name);
+    if (!entry) continue;
+    entry.previousAddresses = Array.isArray(entry.previousAddresses) ? entry.previousAddresses : [];
+    if (!entry.previousAddresses.includes(entry.address)) entry.previousAddresses.push(entry.address);
+    entry.address = address;
+    const idlPath = join(ROOT, PROGRAMS[name].idl);
+    if (existsSync(idlPath)) {
+      const idl = JSON.parse(readFileSync(idlPath, "utf8"));
+      idl.address = address;
+      // metadata.address есть не во всех IDL: не выдумываем поле, которого не было.
+      if (idl.metadata && typeof idl.metadata === "object" && "address" in idl.metadata) idl.metadata.address = address;
+      writeFileSync(idlPath, JSON.stringify(idl, null, 2) + "\n");
+    }
+  }
+  writeFileSync(join(ROOT, REGISTRY), JSON.stringify(registry, null, 2) + "\n");
+
+  // Сгенерированные фикстуры не должны разойтись с _fixtures.ts.
+  const fixtures = join(ROOT, "watchtower", "tests", "_fixtures.gen.ts");
+  const tsNode = join(ROOT, "aof_backend", "node_modules", ".bin", "ts-node");
+  if (existsSync(fixtures) && existsSync(tsNode)) {
+    try {
+      execFileSync(tsNode, ["--project", join(ROOT, "watchtower", "tsconfig.json"), "--transpile-only", fixtures], {
+        cwd: join(ROOT, "aof_backend"), stdio: "inherit",
+        env: { ...process.env, NODE_PATH: join(ROOT, "aof_backend", "node_modules") },
+      });
+      notes.push("watchtower: фикстуры перегенерированы");
+    } catch (error) {
+      notes.push(`watchtower: фикстуры не перегенерированы автоматически (${error.message}); запустите npm test в watchtower/`);
+    }
+  } else {
+    notes.push("watchtower: фикстуры — запустите `cd watchtower && npm test` (нужен ts-node из aof_backend/node_modules)");
+  }
+}
+
+// -------------------------------------------------------------------- гейт --
+if (check || apply) {
+  const anchor = read("Anchor.toml");
+  const clusters = [...anchor.matchAll(/\[programs\.([a-z]+)\]\n([\s\S]*?)(?=\n\[|\n*$)/g)];
+  for (const name of Object.keys(PROGRAMS)) {
+    const address = apply && changed.get(name) ? changed.get(name) : current[name].declared;
+    if (!address) continue;
+    for (const [cluster, body] of clusters.map((m) => [m[1], m[2]])) {
+      const m = body.match(new RegExp(`^\\s*${name}\\s*=\\s*"([^"]+)"`, "m"));
+      if (!m) fail(`Anchor.toml [programs.${cluster}]: нет ${name}`);
+      else if (m[1] !== address) fail(`Anchor.toml [programs.${cluster}].${name} = ${m[1]} != ${address}`);
+    }
+    for (const rel of REQUIRED[name] || []) {
+      if (!exists(rel)) { fail(`нет файла ${rel} (обязан знать адрес ${name})`); continue; }
+      const text = readText(rel);
+      if (!text || !text.includes(address)) fail(`${rel}: нет адреса ${name} (${address}) — после смены здесь останется старый вызов`);
+    }
+    // Ключ, если он рядом, обязан соответствовать объявленному адресу.
+    if (apply && changed.get(name)) continue; // адрес только что приведён к ключу
+    if (current[name].keypairAddress && current[name].keypairAddress !== address) {
+      fail(`${relative(ROOT, current[name].keypair)} принадлежит ${current[name].keypairAddress}, а объявлен ${address}`);
+    }
+  }
+  // Старые адреса не должны остаться нигде, кроме истории.
+  const historical = new Map(); // address -> [files]
+  for (const entry of registry.programs) {
+    for (const old of entry.previousAddresses || []) historical.set(old, entry.name);
+  }
+  if (historical.size) {
+    for (const rel of trackedFiles()) {
+      if (rel === REGISTRY) continue; // здесь прошлые адреса и должны жить
+      const text = readText(rel);
+      if (!text) continue;
+      for (const [old, name] of historical) {
+        if (!text.includes(old)) continue;
+        if (isHistorical(rel)) {
+          notes.push(`history: ${rel} сохраняет старый адрес ${name} — так и задумано (аудит прошлого состояния)`);
+          continue;
+        }
+        fail(`${rel}: остался прежний адрес ${name} (${old}) — смена адресов не закончена`);
+      }
+    }
+  }
+  // Клиентские константы, у которых адрес — не просто строка в списке.
+  if (exists("frontend/src/lib/transactionIntent.ts")) {
+    const intent = read("frontend/src/lib/transactionIntent.ts");
+    if (!/CORE_PROGRAM_ID/.test(intent)) fail("frontend/src/lib/transactionIntent.ts: нет CORE_PROGRAM_ID");
+    if (!/REBIRTH_PROGRAM_ID/.test(intent)) fail("frontend/src/lib/transactionIntent.ts: нет REBIRTH_PROGRAM_ID");
+  }
+  if (exists("scripts/dev-local.sh")) {
+    // Локальный запуск должен читать адрес из реестра: зашитая константа после
+    // смены адресов молча уводит backend на программу, которой нет.
+    const dev = read("scripts/dev-local.sh");
+    for (const name of Object.keys(PROGRAMS)) {
+      if (current[name].declared && dev.includes(current[name].declared)) {
+        fail(`scripts/dev-local.sh: адрес ${name} зашит литералом — читайте ${REGISTRY}`);
+      }
+    }
+  }
+}
+
+// ------------------------------------------------------------------ вывод ---
+const report = {
+  programs: Object.fromEntries(Object.keys(PROGRAMS).map((name) => [name, {
+    declared: current[name].declared,
+    keypair: current[name].keypair ? relative(ROOT, current[name].keypair) : null,
+    keypairAddress: current[name].keypairAddress,
+    next: changed.get(name) || null,
+  }])),
+  writes: writePlan.length,
+  problems,
+  notes,
+};
+
+if (jsonOut) {
+  console.log(JSON.stringify(report, null, 2));
+} else {
+  console.log("Программы:");
+  for (const [name, info] of Object.entries(report.programs)) {
+    const key = info.keypair ? `ключ ${info.keypair} → ${info.keypairAddress}${info.keypairAddress === info.declared ? "" : " (НЕ совпадает с адресом)"}` : "ключа нет";
+    const next = info.next ? ` → будет объявлен ${info.next}` : "";
+    console.log(`  ${name.padEnd(17)} ${info.declared || "—"}  [${key}]${next}`);
+  }
+  if (changed.size) {
+    console.log(`\nПереписать адреса: ${[...changed].map(([n, a]) => `${n} → ${a}`).join(", ")}`);
+    console.log(`Файлов затронуто: ${new Set(writePlan.map((w) => w.file)).size}${apply ? " (записано)" : ""}`);
+    if (!apply) console.log("Это план: запустите ту же команду с --apply.");
+  }
+  for (const note of notes) console.log(`  · ${note}`);
+  if (problems.length) {
+    console.error("\nПроблемы:");
+    for (const problem of problems) console.error(`  ✗ ${problem}`);
+  } else if (check || apply) {
+    console.log("\nАдреса согласованы: declare_id!, Anchor.toml, реестр, IDL, watchtower, клиенты.");
+  }
+}
+
+// Проблемы — это не «предупреждение»: адрес либо совпадает во всех местах, либо
+// игра зовёт программу, которой нет. Поэтому ненулевой код возврата в любом режиме.
+if (problems.length) process.exit(1);
