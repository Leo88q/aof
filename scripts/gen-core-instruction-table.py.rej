+
+# Instructions whose handler reads `ctx.remaining_accounts`: the account list in
+# the IDL is only the fixed prefix, and the trailing accounts are supplied by the
+# caller (the backend). They are NOT free-form: the guard still has to see them
+# validated, which is why this flag is only set for instructions whose handler
+# checks every trailing account against on-chain state
+# (`aof-core/src/instructions/rebirth_reset.rs`). The check below re-reads the
+# Rust source so the table cannot silently claim a fixed list.
+VARIABLE_ACCOUNTS = {
+    "reset_for_rebirth": "pairs",
+}
+# Where each flag was verified: (file, marker of the validation the handler
+# performs on the trailing accounts).
+VARIABLE_ACCOUNTS_EVIDENCE = {
+    "reset_for_rebirth": ("aof-core/src/instructions/rebirth_reset.rs", "ctx.remaining_accounts"),
 }
 
