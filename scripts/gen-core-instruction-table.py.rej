+def verify_variable_accounts() -> None:
+    """Fail loudly when the table claims trailing accounts the source lacks."""
+    for name, (path, marker) in VARIABLE_ACCOUNTS_EVIDENCE.items():
+        if name not in VARIABLE_ACCOUNTS:
+            raise SystemExit(f"{name} has trailing-account evidence but no entry")
+        source = open(path, encoding="utf-8").read()
+        if marker not in source:
+            raise SystemExit(
+                f"{path} no longer contains {marker!r}: "
+                f"{name} must lose trailingAccounts in VARIABLE_ACCOUNTS"
+            )
+
+
 def render() -> str:
+    verify_variable_accounts()
